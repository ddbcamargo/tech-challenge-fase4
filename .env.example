# Modelo público: copie para .env e preencha SOMENTE no seu computador.
# O .env é ignorado pelo Git; nunca coloque chaves reais aqui.
# O programa carrega o .env da raiz do projeto automaticamente.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=
# Opcional: por padrao, o modelo e preparado em models/pose_landmarker_lite.task.
# Use esta variavel apenas para escolher outro arquivo .task local.
POSE_MODEL_PATH=
FASE4_DB_PATH=data/fase4.sqlite3


# 🎙️ Opcional: modelo local para anomalias acústicas (gerado pelo projeto)
VOICE_MODEL_PATH=models/voice_anomaly.joblib
